# Mako Notification Configuration - Acid Dark Theme
# Unified styling with Niri window borders and Waybar floating capsules

font=JetBrainsMono Nerd Font 10.5
background-color=#141419f2
text-color=#f5f5f7ff
border-color=#ffffff40
border-size=1
border-radius=8
width=360
height=150
margin=8
outer-margin=32,12,0,0
padding=12,16
default-timeout=4500
icons=1
max-icon-size=36
icon-border-radius=6
icon-path=/home/aquistus/.local/share/icons/YAMIS:/home/aquistus/.local/share/icons/hicolor:/run/current-system/sw/share/icons/Adwaita:/run/current-system/sw/share/icons/hicolor
progress-color=over #f3f99dff

# Interaction Bindings
on-button-left=invoke-default-action
on-button-middle=dismiss
on-button-right=dismiss-all
on-touch=dismiss

[urgency=low]
border-color=#ffffff25
default-timeout=3000

[urgency=normal]
border-color=#ffffff40
default-timeout=4500

[urgency=critical]
border-color=#ff5c57ff
default-timeout=0
