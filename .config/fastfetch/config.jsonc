{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/aquistus/.config/fastfetch/nixos_medium.txt",
        "type": "file",
        "color": {
            "1": "cyan",
            "2": "blue"
        },
        "padding": {
            "right": 3
        }
    },
    "display": {
        "separator": " · ",
        "color": {
            "keys": "cyan",
            "title": "cyan",
            "separator": "bright_black"
        },
        "size": {
            "maxPrefix": "GB",
            "ndigits": 1,
            "spaceBeforeUnit": "never"
        },
        "freq": {
            "ndigits": 2,
            "spaceBeforeUnit": "never"
        }
    },
    "modules": [
        "title",
        {
            "type": "separator",
            "string": "─",
            "outputColor": "bright_black"
        },
        "os",
        "host",
        {
            "type": "kernel",
            "format": "{release}"
        },
        "uptime",
        {
            "type": "packages",
            "combined": true
        },
        "shell",
        {
            "type": "display",
            "compactType": "original",
            "key": "Resolution"
        },
        "wm",
        "theme",
        "icons",
        "terminal",
        {
            "type": "terminalfont",
            "format": "{/name}{-}{/}{name}{?size} {size}{?}"
        },
        "cpu",
        {
            "type": "gpu",
            "key": "GPU",
            "format": "{name}"
        },
        {
            "type": "memory",
            "format": "{used} / {total}"
        },
        {
            "type": "disk",
            "key": "Storage",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
