{
    "layer": "top",
    "position": "top",
    "height": 28,

    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/window"
    ],
    "modules-center": [],
    "modules-right": [
        "pulseaudio",
        "bluetooth",
        "network",
        "backlight",
        "cpu",
        "memory",
        "battery",
        "clock",
        "tray",
        "custom/power"
    ],

    "sway/mode": {
        "format": "<span foreground='#ff5c57'></span> {}"
    },
    "sway/workspaces": {
        "format": "{name}",
        "disable-scroll": true
    },
    "sway/window": {
        "max-length": 45,
        "tooltip": false
    },
    "clock": {
        "interval": 60,
        "format": "<span foreground='#929292'></span>&#8195;{:%d/%m %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#57c7ff'><b>{}</b></span>",
                "days": "<span color='#eff0eb'>{}</span>",
                "weeks": "<span color='#929292'><b>W{}</b></span>",
                "weekdays": "<span color='#929292'><b>{}</b></span>",
                "today": "<span color='#181818' background='#5af78e'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        },
        "on-click": "/home/aquistus/.config/waybar/toggle-style.sh"
    },
    "battery": {
        "format-icons": ["", "", "", "", ""],
        "format": "<span foreground='#929292'>{icon}</span>&#8195;{capacity}%",
        "format-charging": "<span foreground='#929292'></span>&#8195;{capacity}%",
        "format-discharging": "<span foreground='#929292'>{icon}</span>&#8195;{capacity}%",
        "format-full": "<span foreground='#929292'></span>&#8195;{capacity}%",
        "interval": 30,
        "tooltip": true,
        "tooltip-format": "Pin: {capacity}%\nSức khỏe: {health}%",
        "tooltip-format-charging": "Đang sạc: {capacity}%\nThời gian sạc đầy: {time}\nSức khỏe: {health}%",
        "tooltip-format-discharging": "Pin: {capacity}%\nThời gian còn lại: {time}\nSức khỏe: {health}%",
        "tooltip-format-full": "Đã sạc đầy: 100%\nSức khỏe: {health}%",
        "states": {
            "warning": 25,
            "critical": 10
        }
    },
    "bluetooth": {
        "format": "<span foreground='#929292'></span>&#8195;{status}",
        "format-disabled": "<span foreground='#929292'></span>&#8195;off",
        "format-off": "<span foreground='#929292'></span>&#8195;off",
        "format-on": "<span foreground='#929292'></span>&#8195;on",
        "format-connected": "<span foreground='#929292'></span>&#8195;{num_connections} connected",
        "format-connected-battery": "<span foreground='#929292'></span>&#8195;{device_alias} {device_battery_percentage}%",
        "tooltip": true,
        "tooltip-format": "{controller_alias}\t{controller_address}\n\nStatus: {status}",
        "tooltip-format-disabled": "Bluetooth: off",
        "tooltip-format-off": "Bluetooth: off",
        "tooltip-format-on": "Bluetooth: on (no devices connected)",
        "tooltip-format-connected": "{controller_alias}\t({num_connections} connected)\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": " {device_alias}\t({device_address})",
        "tooltip-format-enumerate-connected-battery": " {device_alias}\t{device_battery_percentage}%\t({device_address})",
        "on-click": "~/.config/waybar/bluetooth-menu.sh",
        "on-click-right": "rfkill toggle bluetooth"
    },
    "network": {
        "format-wifi": "<span foreground='#929292'></span>&#8195;{essid} <span foreground='#929292'>{signalStrength}%</span>",
        "format-ethernet": "<span foreground='#929292'></span>&#8195;wired",
        "format-disconnected": "<span foreground='#929292'></span>&#8195;disconnected",
        "format-disabled": "<span foreground='#929292'></span>&#8195;off",
        "tooltip": true,
        "tooltip-format": "{ifname}",
        "tooltip-format-wifi": " {essid} ({signalStrength}%)\n\nIP: {ipaddr}/{cidr}\nInterface: {ifname}\nGateway: {gwaddr}",
        "tooltip-format-ethernet": " {ifname}\n\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
        "tooltip-format-disconnected": "Wi-Fi: disconnected",
        "tooltip-format-disabled": "Wi-Fi: off",
        "on-click": "~/.config/waybar/wifi-menu.sh",
        "on-click-right": "rfkill toggle wifi"
    },
    "pulseaudio": {
        "format": "<span foreground='#929292'>{icon}</span>&#8195;{volume}%",
        "format-muted": "<span foreground='#ff5c57'>󰝟</span>&#8195;{volume}%",
        "format-icons": {
            "default": [""],
            "headphones": [""]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "tooltip": true,
        "tooltip-format": "Âm lượng: {volume}%\nThiết bị: {desc}"
    },
    "backlight": {
        "format": "<span foreground='#929292'></span>&#8195;{percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip": true,
        "tooltip-format": "Độ sáng: {percent}%"
    },
    "cpu": {
        "interval": 3,
        "format": "<span foreground='#929292'></span>&#8195;{usage}%",
        "tooltip": false
    },
    "memory": {
        "interval": 5,
        "format": "<span foreground='#929292'></span>&#8195;{percentage}%",
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}GB / {total:0.1f}GB ({percentage}%)\nSwap: {swapUsed:0.1f}GB / {swapTotal:0.1f}GB ({swapPercentage}%)"
    },
    "tray": {
        "spacing": 8
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Power Menu",
        "on-click": "/home/aquistus/.config/sway/powermenu.sh"
    }
}
