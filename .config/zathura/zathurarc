# ------------------------------------------------------------------------------
# Zathura Configuration - Acid Dark & SyncTeX Setup
# ------------------------------------------------------------------------------

# Font & Display
set font "JetBrains Mono 10.5"
set default-bg "#222222"
set default-fg "#eff0eb"

# Status & Input Bar
set statusbar-bg "#1e1e1e"
set statusbar-fg "#eff0eb"
set inputbar-bg "#1e1e1e"
set inputbar-fg "#57c7ff"

# Notifications
set notification-bg "#282a36"
set notification-fg "#eff0eb"
set notification-error-bg "#ff5c57"
set notification-error-fg "#222222"
set notification-warning-bg "#f3f99d"
set notification-warning-fg "#222222"

# Highlights & Search
set highlight-color "rgba(87, 199, 255, 0.35)"
set highlight-active-color "rgba(243, 249, 157, 0.45)"

# Completion menu
set completion-bg "#282a36"
set completion-fg "#eff0eb"
set completion-highlight-bg "#444444"
set completion-highlight-fg "#57c7ff"

# Dark Mode Recolor (Toggle with 'Ctrl + r')
set recolor-lightcolor "#222222"
set recolor-darkcolor "#eff0eb"
set recolor "false"
set recolor-keephue "true"

# Behavior
set render-loading "false"
set scroll-step 50
set selection-clipboard "clipboard"
set window-title-basename "true"

# Two-way SyncTeX (Ctrl + Left Click in Zathura jumps back to Neovim)
set synctex true
set synctex-editor-command "nvim --headless -c \"VimtexInverseSearch %{line} '%{input}'\""
