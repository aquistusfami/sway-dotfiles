#!/usr/bin/env python3
import sys
import os
import re
import socket
import subprocess

def get_current_song():
    try:
        s = socket.socket()
        s.settimeout(1.0)
        s.connect(('127.0.0.1', 6600))
        s.recv(1024)
        s.sendall(b'currentsong\n')
        data = s.recv(4096).decode('utf-8', errors='ignore')
        s.close()
        for line in data.splitlines():
            if line.startswith('file: '):
                return line[6:].strip()
    except Exception:
        pass
    return None

def notify(msg, title="Lyrics Sync"):
    try:
        subprocess.run(["notify-send", "-t", "1500", "-i", "audio-speakers", title, msg], check=False)
    except Exception:
        pass

def main():
    arg = sys.argv[1].strip() if len(sys.argv) > 1 and sys.argv[1].strip() else None
    specified_file = sys.argv[2] if len(sys.argv) > 2 else None

    lrc_path = None
    if specified_file and os.path.exists(specified_file):
        lrc_path = specified_file
    else:
        current = get_current_song()
        if not current:
            print("No song currently playing.")
            sys.exit(1)
        base = os.path.splitext(current)[0]
        music_dir = os.path.expanduser("~/Music")
        candidate = os.path.join(music_dir, f"{base}.lrc")
        if os.path.exists(candidate):
            lrc_path = candidate
        else:
            # Check if full path was in current
            if os.path.exists(f"{os.path.splitext(current)[0]}.lrc"):
                lrc_path = f"{os.path.splitext(current)[0]}.lrc"

    if not lrc_path or not os.path.exists(lrc_path):
        print("LRC file not found for current song.")
        notify("LRC file not found", "Lyrics Sync")
        sys.exit(1)

    with open(lrc_path, 'r', encoding='utf-8', errors='ignore') as f:
        content = f.read()

    lines = content.splitlines()
    offset_idx = -1
    current_offset = 0

    for i, line in enumerate(lines):
        m = re.match(r'^\[offset:\s*([+-]?\d+)\s*\]', line.strip(), re.IGNORECASE)
        if m:
            offset_idx = i
            current_offset = int(m.group(1))
            break

    if arg is None:
        print(f"File: {os.path.basename(lrc_path)}")
        print(f"Current offset: {current_offset} ms")
        notify(f"Current offset: {current_offset} ms\n({os.path.basename(lrc_path)})")
        return

    # Parse argument
    arg = arg.strip()
    if arg.startswith('+') or arg.startswith('-'):
        new_offset = current_offset + int(arg)
    elif arg.startswith('='):
        new_offset = int(arg[1:])
    else:
        new_offset = int(arg)

    offset_line = f"[offset:{new_offset}]"

    if offset_idx >= 0:
        lines[offset_idx] = offset_line
    else:
        lines.insert(0, offset_line)

    with open(lrc_path, 'w', encoding='utf-8') as f:
        f.write('\n'.join(lines) + '\n')

    song_name = os.path.basename(lrc_path).replace('.lrc', '')
    print(f"✓ Updated offset: {current_offset} ms -> {new_offset} ms ({song_name})")
    notify(f"Offset: {new_offset} ms ({'+' if new_offset>0 else ''}{new_offset - current_offset} ms)\n{song_name}")

if __name__ == '__main__':
    main()
