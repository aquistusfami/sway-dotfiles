#!/bin/sh
# Wi-Fi power save: off while on AC (low latency), on while on battery.
# Called by NetworkManager on connect (it re-enables power save on every association)
# and by udev when the charger is plugged/unplugged.
SYS=${SYS:-/sys}

on_ac=0
for s in "$SYS"/class/power_supply/*; do
    [ "$(cat "$s/type" 2>/dev/null)" = Mains ] && [ "$(cat "$s/online" 2>/dev/null)" = 1 ] && on_ac=1
done
[ "$on_ac" = 1 ] && state=off || state=on

for dev in "$SYS"/class/net/*; do
    [ -d "$dev/wireless" ] || continue
    iw dev "${dev##*/}" set power_save "$state" && logger -t wifi-powersave "${dev##*/}: power_save $state (AC=$on_ac)"
done
exit 0
